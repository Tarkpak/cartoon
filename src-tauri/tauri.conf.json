{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Playlet Desktop",
  "version": "1.0.114",
  "identifier": "com.playlet.desktop",
  "mainBinaryName": "playlet-desktop",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.output/public": "web/public"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBRjczRTZDNjYxOTg5NTgKUldSWWlSbG1iRDczeWtWVGdHUDducU0wb2lGQVNYUUF5M0RNdllhZjNocTNjY1BablpLVjhNWGEK",
      "endpoints": [
        "https://playlet-ai.tos-cn-guangzhou.volces.com/manju-assets/desktop-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
