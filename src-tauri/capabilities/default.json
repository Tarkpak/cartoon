{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "remote": {
    "urls": [
      "http://127.0.0.1:43127/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-check-ffmpeg-status",
    "allow-install-ffmpeg",
    "allow-open-local-path",
    "allow-open-local-directory",
    "allow-open-external-url",
    "allow-save-settings-config-export",
    "notification:default",
    "process:default",
    "updater:default"
  ]
}
