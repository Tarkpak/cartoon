{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["app/*"],
      "~/*": ["app/*"],
      "#shared/*": ["shared/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.vue",
    "shared/**/*.ts",
    "app/types/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "auto-imports.d.ts",
    "components.d.ts"
  ]
}
